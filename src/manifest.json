{
  "manifest_version": 3,
  "name": "Caveatly",
  "version": "0.2.0",
  "description": "Blocks ads and trackers on every site, and reads the fine print: flags what matters in terms of service and privacy policies.",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "favicon",
    "privacy",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Caveatly",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "consent.js",
        "pagescan.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/custom-rules.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "easylist",
        "enabled": true,
        "path": "filters/easylist.json"
      },
      {
        "id": "easyprivacy",
        "enabled": true,
        "path": "filters/easyprivacy.json"
      },
      {
        "id": "reuters",
        "enabled": true,
        "path": "filters/reuters.json"
      },
      {
        "id": "cookies",
        "enabled": true,
        "path": "filters/cookies.json"
      },
      {
        "id": "annoyances",
        "enabled": false,
        "path": "filters/annoyances.json"
      }
    ]
  }
}
